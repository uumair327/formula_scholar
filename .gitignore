# Firebase configuration (SENSITIVE — regenerate via FlutterFire CLI)
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist
firebase_app_id_file.json
lib/firebase_options.dart
**/firebase_options.dart
formula-scholar-firebase-adminsdk-*.json
**/*-firebase-adminsdk-*.json

# Firebase Admin SDK service account keys (CRITICAL — NEVER commit)
*-firebase-adminsdk-*.json
**/service-account*.json
**/serviceAccount*.json
*firebase-adminsdk*.json
firebase-adminsdk*.json

# Local scratch and test scripts (often contain secrets)
test_*_key.dart
test_secrets.dart
test_redact.dart
scratch_*.dart

# Amplify / AWS
amplify/
aws-exports.dart

# Android signing
**/key.properties
**/release.keystore
**/upload-keystore.jks
**/*.keystore
**/*.jks
