# ─────────────────────── 🔐 SECRETS / CREDENTIALS ───────────────
# Environment files
.env
.env.*
.env.local
.env.*.local
*.local
!.env.example
.envrc

# Local secret stores
.secrets/
.firebase/

# TLS/SSL certificates
*.pem
*.p12
*.key
*.cert
