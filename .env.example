# ══════════════════════════════════════════════════════════════════
# Formula Scholar — Environment Variables
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it is in .gitignore.
#
# For Firebase setup instructions, see docs/FIREBASE_SETUP.md
# ══════════════════════════════════════════════════════════════════

# ─── Firebase Configuration ──────────────────────────────────────
# These values are obtained from your Firebase Console:
# https://console.firebase.google.com → Project Settings → General
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY_WEB=your-web-api-key
FIREBASE_API_KEY_ANDROID=your-android-api-key
FIREBASE_API_KEY_IOS=your-ios-api-key
FIREBASE_APP_ID_WEB=your-web-app-id
FIREBASE_APP_ID_ANDROID=your-android-app-id
FIREBASE_APP_ID_IOS=your-ios-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── iOS Bundle ID ───────────────────────────────────────────────
IOS_BUNDLE_ID=com.example.formulaScholar

# ─── Firebase Admin SDK (for scripts/seeder only) ────────────────
# Path to your Firebase Admin SDK service account JSON file.
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# NEVER commit this file. Store it securely outside the repo.
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/your-service-account-key.json

# ─── Google Sign-In (OAuth) ──────────────────────────────────────
# Web Client ID for Google Sign-In (from Google Cloud Console)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
